# Handle application windows

for_window [app_id="firefox" title="Firefox — Sharing Indicator"] floating enable
for_window [title="Torrent Options"] floating enable

bar {
  swaybar_command waybar
}

include /etc/sway/config.d/*

seat seat0 xcursor_theme Hackneyed 16

# Set GTK theme

exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme 'Zukitwo'
    gsettings set org.gnome.desktop.interface icon-theme 'Newaita'
    gsettings set org.gnome.desktop.interface cursor-theme 'Hackneyed'
    gsettings set org.gnome.desktop.interface font-name 'DejaVu Sans 9'
}

# Autostart apps

exec gammastep -l 47.51:19.05 -t 6500K:2500K

exec nm-applet --indicator

exec blueman-applet

exec mako --font $font

# Required for screen sharing

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
